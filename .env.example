# Optional. Add this in your hosting provider's Environment Variables settings.
# Without a key the site runs entirely in honest guided-check mode.
SORSA_API_KEY=your_sorsa_api_key_here

# Your hosting provider sets PORT, so don't normally add it in production.
PORT=3000

# Only set to true behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
